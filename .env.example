# Copy to .env at the repo root (never commit .env).
# Docker Compose / Makefile load this file automatically.

# Carto basemap API key for the provincial map tiles
VITE_CARTO_API_KEY=

# AEMET OpenData API key (forecast in Clima)
AEMET_API_KEY=

# Postgres (container agro-postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# DWH role used by dashboard-api and dbt (must match init-databases.sql / existing DB)
POSTGRES_DWH_HOST=postgres
POSTGRES_DWH_PORT=5432
POSTGRES_DWH_DB=agro_sequia
POSTGRES_DWH_USER=dwh_user
POSTGRES_DWH_PASSWORD=dwh_password
POSTGRES_DWH_SCHEMA=marts
